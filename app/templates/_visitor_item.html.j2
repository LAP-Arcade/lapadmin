{% if visitor.is_deleted %}
<span class="title"><em>Visiteur supprimé</em></span>
{% elif visitor.nick %}
<span class="title">{{ visitor.nick }}</span>
{% if visitor.full_name %}
<small>({{ visitor.full_name }})</small>
{% endif %}
{% else %}
<span class="title">{{ visitor.full_name }}</span>
{% endif %}
