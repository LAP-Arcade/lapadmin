{% extends "base.html.j2" %}
{% set page_title = date.format('MMMM YYYY', locale='fr') | capitalize %}

{% block styles %}
<style>
    #calendar {
        width: calc(700px + 2rem);
        min-width: calc(700px + 2rem);
    }

    #calendar-quick-switch {
        display: flex;
        align-items: center;
    }

    #calendar a {
        text-decoration: none;
    }

    #calendar-quick-switch .material-icons {
        font-size: 3em;
    }

    #calendar [type="checkbox"] + span {
        padding-left: 24px;
    }

    #calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    #calendar-weekdays {
        text-align: center;
        margin-bottom: 1em;
    }

    #calendar .cell {
        height: 100px;
        border: 1px solid black;
        padding: 0.5em;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }


    #calendar .cell:hover {
        background: gold;
    }

    #calendar .weekend .cell-date { color: red }
    #calendar .past { background: rgb(230, 230, 230) }
    #calendar .opening { background: lightgreen }

    #calendar .today:after {
        content: '';
        position: absolute;
        top: -20px;
        right: -20px;
        background: red;
        width: 40px;
        height: 40px;
        transform: rotate(45deg);
    }

    #calendar .calendar-row {
        display: flex;
    }

    #calendar .calendar-row > * {
        width: calc(100% / 7);
    }

    #calendar .cell {
        height: 100px;
        cursor: pointer;
    }

    #calendar .cell-date-full {
        display: none;
    }

    #calendar .availability {
        font-size: 0.75em;
        height: 2em;
        padding: 0;
    }

    #calendar .availability {
        background: lightgreen;
    }
    #calendar .availability:has(option[value=""]:checked) {
        background: white;
    }

    @media screen and (max-width: 700px) {
        #calendar {
            width: auto;
            min-width: 0;
        }

        #calendar #calendar-weekdays {
            display: none;
        }

        #calendar-title {
            font-size: 1.5rem;
            margin-top: 10px;
        }

        #calendar .calendar-row {
            display: block;
        }

        #calendar .calendar-row > * {
            width: 100%;
        }

        #calendar .other-month {
            display: none;
        }

        #calendar .cell {
            height: auto;
            min-height: 3rem;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
        }

        #calendar .cell-date {
            display: none;
        }

        #calendar .cell-date-full {
            display: inline;
        }
    }
</style>
{% endblock styles %}

{% block content %}
<div id="calendar" class="widget">
    <header id="calendar-header">
        <div id="calendar-quick-switch">
            <a
                id="calendar-quick-switch-prev"
                class="material-icons"
                href="{{ url_for('.calendar_month', month=previous) }}"
            >
                chevron_left
            </a>
            <a
                id="calendar-quick-switch-next"
                class="material-icons"
                href="{{ url_for('.calendar_month', month=next) }}"
            >
                chevron_right
            </a>
        </div>
        <h2 id="calendar-title">
            {{ date.format('MMMM YYYY', locale='fr') | capitalize }}
        </h2>
    </header>
    <main id="calendar-main">
        <div id="calendar-weekdays" class="calendar-row">
            <div class="calendar-weekday">Lun</div>
            <div class="calendar-weekday">Mar</div>
            <div class="calendar-weekday">Mer</div>
            <div class="calendar-weekday">Jeu</div>
            <div class="calendar-weekday">Ven</div>
            <div class="calendar-weekday">Sam</div>
            <div class="calendar-weekday">Dim</div>
        </div>
        <div id="calendar-days">
            {% for i in range(0, 6) %}
            <div class="calendar-row">
                {% for day in days[0 + i * 7:7 + i * 7] %}
                <div
                    data-date="{{ day.date.format('YYYY-MM-DD') }}"
                    class="
                        cell
                        {% if day.is_past %}past{% endif %}
                        {% if day.is_today %}today{% endif %}
                        {% if day.is_weekend %}weekend{% endif %}
                        {% if day.openings %}opening{% endif %}
                        {% if day.date.format('YYYY-MM') != month %}other-month{% endif %}
                    "
                    {# href="{{ url_for('.calendar_day', month=day.date.format('YYYY-MM'), day=day.date.format('DD')) }}" #}
                >
                    <span class="cell-date">
                        {{ day }}
                    </span>
                    <span class="cell-date-full">
                        {{ day.date.format('ddd D', locale='fr') | capitalize }}
                    </span>
                    <span class="staffings">
                        {% for availability in day.availabilities %}
                            <span class="staffing">{{ availability }}</span>
                        {% endfor %}
                    </span>
                    <span class="actions">
                        <select class="availability browser-default">
                            <option value="">Dispo: non</option>
                            <option
                                value="{{ Availability.Type.ALL_DAY }}"
                                {% if day.me == Availability.Type.ALL_DAY %}
                                selected
                                {% endif %}
                            >Entière</option>
                            <option
                                value="{{ Availability.Type.OPENING }}"
                                {% if day.me == Availability.Type.OPENING %}
                                selected
                                {% endif %}
                            >Ouverture</option>
                            <option
                                value="{{ Availability.Type.CLOSING }}"
                                {% if day.me == Availability.Type.CLOSING %}
                                selected
                                {% endif %}
                            >Fermeture</option>
                        </select>
                        </label>
                    </span>
                </div>
                {% endfor %}
            </div>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock content %}

{% block scripts %}
<script>
document.querySelectorAll('#calendar .cell').forEach((cell) => {
    cell.addEventListener('click', (event) => {
        const date = cell.dataset.date;
        const month = "{{ month }}";
        const url = "{{ url_for('.calendar_day', month=month, day='') }}" + date.split('-')[2];

        window.location.href = url;
    });
});
document.querySelectorAll('#calendar .availability').forEach((select) => {
    select.addEventListener('click', (event) => {
        event.stopPropagation();
    });
    select.addEventListener('change', (event) => {
        const value = event.target.value;
        const cell = event.target.closest('.cell');
        const url = "{{ url_for('.set_availability', date='') }}" + cell.dataset.date;

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                type: value,
            }),
        }).then((response) => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        }).then((data) => {
            console.log('Success:', data);
        }).catch((error) => {
            console.error('Error:', error);
        });
    });
});
</script>
{% endblock scripts %}
