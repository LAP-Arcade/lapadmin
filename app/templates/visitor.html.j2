{% extends "base.html.j2" %}
{% set page_title = title if title else "Visiteur #" ~ visitor.id ~ " " ~ visitor.short_name %}

{% block styles %}
<style>
    .self-edit-delete-btn:hover,
    .self-edit-delete-btn:focus {
        background-color: rgba(229, 57, 53, 0.15);
    }

    .self-edit-delete-btn:hover i,
    .self-edit-delete-btn:focus i {
        color: #e53935 !important;
    }

    .visits-table {
        width: 100%;
        border-collapse: collapse;
    }
    .visits-table th,
    .visits-table td {
        padding: 0.5em 0.75em;
        text-align: left;
        border-bottom: 1px solid #eee;
        vertical-align: middle;
    }
    .visits-table th {
        font-weight: bold;
        color: gray;
        font-size: 0.85em;
        text-transform: uppercase;
    }
    .visits-table tr:hover td {
        background: #f9f9f9;
    }
</style>
{% endblock styles %}

{% block content %}

<div class="container">
    {% if title %}
    <h1>{{ title }}</h1>
    {% elif visitor %}
    <h1>Visiteur #{{ visitor.id }} <small>{{ visitor.short_name }}</small></h1>
    {% endif %}

    {% include "_form_errors.html.j2" %}

    <div class="widget">
        <form method="post" action="." id="visitor-form">
        {{ form.hidden_tag() }}
        <div class="row">
            <div class="input-field col s12 m6">
                {{ form.first_name.label }}
                {{ form.first_name }}
            </div>
            <div class="input-field col s12 m6">
                {{ form.last_name.label }}
                {{ form.last_name }}
            </div>
        </div>
        <div class="row">
            <div class="input-field col s12 m6">
                {{ form.nick.label }}
                {{ form.nick }}
            </div>
            <div class="input-field col s12 m6">
                {{ form.email.label }}
                {{ form.email }}
            </div>
        </div>
        <div class="row">
            <div class="col s12">
                <label>
                    {% if visitor and visitor.member_since %}
                    {{ form.is_member(checked=true, disabled=true) }}
                    <span>{{ form.is_member.label.text }} depuis le {{ visitor.member_since.strftime('%d/%m/%Y') }}</span>
                    {% else %}
                    {{ form.is_member() }}
                    <span>{{ form.is_member.label.text }}</span>
                    {% endif %}
                </label>
            </div>
        </div>
        </form>

        {% if visitor %}
        {% if visitor.self_edit_uuid %}
        {% set self_edit_url = url_for('visitor_self_edit', uuid=visitor.self_edit_uuid, _external=True) %}
        <div class="row valign-wrapper" style="margin-bottom: 1.5em;">
            <span style="margin-right: 0.5em;">Lien d'édition à usage unique :</span>
            <a href="{{ self_edit_url }}" target="_blank" id="self-edit-url" style="word-break: break-all; flex: 1 1 auto;">{{ self_edit_url }}</a>
            <a class="btn-flat btn-small waves-effect" onclick="copySelfEditUrl()" title="Copier le lien">
                <i class="material-icons grey-text text-darken-1">content_copy</i>
            </a>
            <a class="btn-flat btn-small waves-effect" href="{{ url_for('visitor_self_edit_qr', uuid=visitor.self_edit_uuid) }}" target="_blank" title="Afficher le QR code">
                <i class="material-icons grey-text text-darken-1">qr_code_2</i>
            </a>
            <form method="post" action="{{ url_for('.visitor_self_edit_link_delete', id=visitor.id) }}" style="display: inline;" onsubmit="return confirm('Supprimer ce lien d\'édition ?');">
                {{ self_edit_link_form.hidden_tag() }}
                <button class="btn-flat btn-small waves-effect self-edit-delete-btn" type="submit" title="Supprimer le lien">
                    <i class="material-icons grey-text text-darken-1">delete</i>
                </button>
            </form>
        </div>
        <script>
            function copySelfEditUrl() {
                navigator.clipboard.writeText(document.getElementById('self-edit-url').href);
                M.toast({html: 'Lien copié'});
            }
        </script>
        {% else %}
        <form method="post" action="{{ url_for('.visitor_self_edit_generate', id=visitor.id) }}" style="margin-bottom: 1.5em;">
            {{ self_edit_link_form.hidden_tag() }}
            <button class="btn-small waves-effect waves-light blue" type="submit">
                Générer un lien d'édition à usage unique
                <i class="material-icons right">link</i>
            </button>
        </form>
        {% endif %}
        {% endif %}

        <div class="form-actions">
            <button class="btn waves-effect waves-light" type="submit" form="visitor-form" name="action">Enregistrer
                <i class="material-icons right">send</i>
            </button>

            {% if visitor %}
            <a href="{{ url_for('.visitor_delete', id=visitor.id) }}" class="btn waves-effect waves-light red darken-1">Supprimer
                <i class="material-icons right">delete</i>
            </a>
            {% endif %}
        </div>
    </div>

    {% if visitor %}
    <div class="widget">
        <h2>Visites</h2>
        <p>
            Total : {{ visits|length }}
        </p>

        {% if visits %}
        <div class="table-scroll">
        <table class="visits-table">
            <thead>
                <tr>
                    <th class="nowrap">Date</th>
                    <th>Entrée</th>
                    <th>Sortie</th>
                    <th>Durée</th>
                    <th class="nowrap">Montant</th>
                    <th>Payé</th>
                    <th>Invités</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                {% for visit in visits %}
                <tr>
                    <td class="nowrap">
                        <a href="{{ url_for('.calendar_day', month=visit.opening.start | arrow('format', 'YYYY-MM'), day=visit.opening.start | arrow('format', 'DD')) }}">
                            {{ visit.opening.start | arrow('format', 'D MMM YYYY') }}
                        </a>
                    </td>
                    <td>{{ visit.entry | arrow('format', 'HH:mm') if visit.entry else '-' }}</td>
                    <td>{{ visit.exit | arrow('format', 'HH:mm') if visit.exit else '-' }}</td>
                    <td>{{ visit.duration | format_duration if visit.entry and visit.exit else '-' }}</td>
                    <td class="nowrap">{{ '%.2f €' | format(visit.effective_price) if visit.effective_price is not none else '-' }}</td>
                    <td>{{ 'Oui' if visit.paid else 'Non' }}</td>
                    <td>{{ invitee_counts.get(visit.opening_id, 0) }}</td>
                    <td>{{ visit.note or '-' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
        <p class="grey-text">Aucune visite trouvée.</p>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock content %}
